import { safeHotelImage, handleHotelImageError } from "../utils/hotelImage.js";
import { Link, useNavigate, useSearchParams } from "react-router-dom";
import { useEffect, useMemo, useState } from "react";
import Navbar from "./Navbar";
import {
  getCurrentUser,
  getUserWishlist,
  getCity,
  normalizeCity
} from "../utils/stayhub";
import { apiRequest, fetchHotels, fetchOsmHotels, fetchHotelbedsSearch, fetchStayingApiSearch } from "../utils/api";

async function convertHotelPricesToINR(hotels) {
  const currencies = [
    ...new Set(
      hotels
        .filter((hotel) => Number(hotel.price) > 0)
        .map((hotel) => String(hotel.currency || "INR").toUpperCase())
        .filter((currency) => currency !== "INR")
    ),
  ];

  const rates = {};

  await Promise.all(
    currencies.map(async (currency) => {
      const controller = new AbortController();
      const timeoutId = setTimeout(() => controller.abort(), 2000);

      try {
        const response = await fetch(
          `https://open.er-api.com/v6/latest/${encodeURIComponent(currency)}`,
          { signal: controller.signal }
        );
        if (!response.ok) return;

        const result = await response.json();
        const rate = Number(result?.rates?.INR);
        if (Number.isFinite(rate) && rate > 0) {
          rates[currency] = rate;
        }
      } catch (error) {
        console.warn(`INR conversion rate unavailable for ${currency}.`, error);
      } finally {
        clearTimeout(timeoutId);
      }
    })
  );

  return hotels.map((hotel) => {
    const currency = String(hotel.currency || "INR").toUpperCase();
    const amount = Number(hotel.price);

    if (!Number.isFinite(amount) || amount <= 0) {
      return { ...hotel, currency: "INR" };
    }

    if (currency === "INR") {
      return { ...hotel, price: amount, currency: "INR" };
    }

    const rate = rates[currency];

    if (!rate) {
      // Never treat an unconverted foreign-currency amount as INR.
      return {
        ...hotel,
        price: 0,
        currency: "INR",
        originalCurrency: currency,
        originalPrice: amount,
        priceConversionUnavailable: true,
      };
    }

    return {
      ...hotel,
      price: amount * rate,
      currency: "INR",
      originalCurrency: currency,
      originalPrice: amount,
    };
  });
}

const selectStyle = {
  width: "100%",
  boxSizing: "border-box",
  padding: "12px 13px",
  border: "1px solid #cbd5e1",
  borderRadius: "10px",
  background: "white",
  color: "#0f172a",
  fontSize: "14px",
  outline: "none"
};

const buttonStyle = {
  border: "1px solid #cbd5e1",
  background: "white",
  color: "#334155",
  padding: "10px 15px",
  borderRadius: "10px",
  cursor: "pointer",
  fontWeight: "700"
};

function Hotels() {
  const [params] = useSearchParams();
  const searchKey = params.toString();
  const navigate = useNavigate();

  const [hotels, setHotels] = useState([]);
  const [loading, setLoading] = useState(true);
  const [apiError, setApiError] = useState("");
  const [liveSearchWarning, setLiveSearchWarning] = useState("");

  const [search, setSearch] = useState(params.get("destination") || "");
  const [location, setLocation] = useState("All");
  const [category, setCategory] = useState("All");
  const [priceRange, setPriceRange] = useState("All");
  const [rating, setRating] = useState("All");
  const [sort, setSort] = useState("Recommended");
  const [filtersOpen, setFiltersOpen] = useState(false);
  const [wishlist, setWishlist] = useState(() =>
    getUserWishlist(getCurrentUser())
  );

  const currentUser = getCurrentUser();

  useEffect(() => {
    let active = true;

    async function loadHotels() {
      try {
        setLoading(true);
        setApiError("");
        setLiveSearchWarning("");

        const searchParams = new URLSearchParams(searchKey);
        const checkIn = searchParams.get("checkIn") || "";
        const checkOut = searchParams.get("checkOut") || "";
        const adults = searchParams.get("adults") || "2";
        const children = searchParams.get("children") || "0";
        const childAges = searchParams.get("childAges") || "";
        const rooms = searchParams.get("rooms") || "1";
        const destination = searchParams.get("destination") || "";

        let catalogueData = await fetchHotels();

        // Render available catalogue results without waiting for live providers.
        if (active && Array.isArray(catalogueData) && catalogueData.length > 0) {
          setHotels(
            catalogueData.map((hotel) => ({
              ...hotel,
              priceSource: hotel.priceSource || (
                hotel.source === "osm" ? "demo-estimate" : "catalogue"
              )
            }))
          );
          setLoading(false);
        }
        let usingOsmListings = false;

        // Prefer city-specific OSM listings when a destination is searched.
        if (destination.trim()) {
          try {
            const osmData = await fetchOsmHotels(destination);

            if (Array.isArray(osmData) && osmData.length > 0) {
              catalogueData = [...catalogueData, ...osmData];
              usingOsmListings = true;

              if (active) {
                setLiveSearchWarning(
                  "Hotel listings are from OpenStreetMap. Prices and room availability are demo estimates, not live offers."
                );
              }
            } else if (active) {
              setLiveSearchWarning(
                "No OpenStreetMap listings found for this destination. Showing the existing hotel catalogue."
              );
            }
          } catch (osmError) {
            console.warn(
              "OSM search unavailable; using the existing hotel catalogue.",
              osmError
            );

            if (active) {
              setLiveSearchWarning(
                "OpenStreetMap search is temporarily unavailable. Showing the existing hotel catalogue."
              );
            }
          }
        }

        let data = catalogueData.map((hotel) => ({
          ...hotel,
          priceSource: hotel.priceSource || (
            hotel.source === "osm" ? "demo-estimate" : "catalogue"
          )
        }));

        if (checkIn && checkOut && !usingOsmListings) {
          try {
            const liveData = await fetchHotelbedsSearch({
              destination,
              checkIn,
              checkOut,
              adults,
              children,
              childAges,
              rooms
            });

            // Match rates only through the explicit Hotelbeds provider code.
            // Never assume a provider ID equals a local database hotel ID.
            const liveByHotelbedsCode = new Map(
              liveData
                .filter((hotel) => Number(hotel.hotelbedsCode) > 0)
                .map((hotel) => [
                  String(Number(hotel.hotelbedsCode)),
                  hotel
                ])
            );

            const mergedCatalogue = catalogueData.map((local) => {
              const code = Number(local.hotelbeds_code);
              const live = Number.isInteger(code) && code > 0
                ? liveByHotelbedsCode.get(String(code))
                : null;

              if (!live) {
                return { ...local, priceSource: local.priceSource || "catalogue" };
              }

              liveByHotelbedsCode.delete(String(code));
              const livePrice = Number(live.price || live.minRate || 0);

              return {
                ...local,
                id: local.id,
                name: local.name || live.name,
                location: local.location || live.location,
                category: local.category || live.category,
                image: local.image || live.image,
                description: local.description || live.description,
                rating: Number(local.rating) > 0
                  ? Number(local.rating)
                  : Number(live.rating) || 0,
                price: livePrice > 0
                  ? livePrice
                  : Number(local.price || 0),
                currency: livePrice > 0
                  ? (live.currency || "INR")
                  : (local.currency || "INR"),
                hotelbedsCode: live.hotelbedsCode,
                rateKey: live.rateKey || "",
                rates: Array.isArray(live.rates) ? live.rates : [],
                priceSource: livePrice > 0 ? "live" : "catalogue"
              };
            });

            // Only catalogue hotels have local detail and booking records.
            // Do not append provider-only rows with IDs the booking flow cannot resolve.
            data = mergedCatalogue;

            if (!liveData.length && active) {
              setLiveSearchWarning(
                "No live rates were returned for these dates. Catalogue prices are estimates, not confirmed rates."
              );
            } else if (
              liveData.some((hotel) => !(Number(hotel.price || hotel.minRate) > 0)) &&
              active
            ) {
              setLiveSearchWarning(
                "Some hotels have no confirmed live price for these dates."
              );
            }
          } catch (liveError) {
            console.warn(
              "Hotelbeds live search unavailable; keeping local STAYHUB data.",
              liveError
            );
            if (active) {
              setLiveSearchWarning(
                "Live prices could not be verified. Displayed catalogue prices are estimates."
              );
            }
          }
        }

        // Add separate date-specific Google Hotels listings from StayingAPI.
        // These external listings are not local STAYHUB booking records.
        if (destination.trim() && checkIn && checkOut) {
          try {
            const stayingResult = await fetchStayingApiSearch({
              destination,
              checkIn,
              checkOut,
              adults,
              children
            });

            const stayingData = Array.isArray(stayingResult?.data)
              ? stayingResult.data
              : [];

            const externalHotels = stayingData
              .filter((hotel) => hotel && hotel.name)
              .map((hotel, index) => {
                const nightlyPrice = Number(hotel.nightlyPrice) || 0;
                const guestRating = Number(hotel.rating) || 0;
                const stars = Number(hotel.starRating) || 0;
                const city = String(
                  hotel.location?.city || destination.split(",")[0] || destination
                ).trim();

                return {
                  id: `stayingapi-${hotel.id || index}`,
                  name: hotel.name,
                  location: city,
                  category: stars >= 5 ? "Luxury" : stars >= 4 ? "Premium" : "Budget",
                  image: hotel.image || "",
                  description: `Google Hotels listing · ${Number(hotel.reviewCount) || 0} reviews`,
                  rating: guestRating,
                  price: nightlyPrice,
                  currency: hotel.currency || "INR",
                  priceSource: nightlyPrice > 0 ? "live" : "catalogue",
                  source: "stayingapi",
                  externalOnly: true,
                  externalUrl: hotel.url || "",
                  externalTotalPrice: Number(hotel.totalPrice) || 0,
                  externalCurrency: hotel.currency || "",
                  externalNights: Number(hotel.nights) || 0,
                  externalPriceBasis: hotel.priceBasis || "",
                  providerStarRating: stars
                };
              });

            // Avoid showing the same provider result more than once.
            const seen = new Set();
            const uniqueExternalHotels = externalHotels.filter((hotel) => {
              const key = hotel.name.trim().toLowerCase();
              if (seen.has(key)) return false;
              seen.add(key);
              return true;
            });

            data = [...data, ...uniqueExternalHotels];

            if (active && uniqueExternalHotels.length > 0) {
              setLiveSearchWarning(
                "Live Google Hotels quotes are shown where available. Prices can change on the provider website; external listings are not booked through STAYHUB."
              );
            } else if (active) {
              setLiveSearchWarning(
                "No live Google Hotels listings were returned. Existing catalogue prices are not confirmed rates."
              );
            }
          } catch (stayingError) {
            console.warn("StayingAPI search unavailable.", stayingError);

            if (active) {
              setLiveSearchWarning(
                "Live Google Hotels search is temporarily unavailable. Existing STAYHUB listings are still shown."
              );
            }
          }
        }


        // Remove obvious non-hotel OSM results and deduplicate listings.
        const isIrrelevantOsmListing = (hotel) => {
          if (String(hotel.source || "").toLowerCase() !== "osm") {
            return false;
          }

          const text = [
            hotel.name,
            hotel.category,
            hotel.description
          ].filter(Boolean).join(" ").toLowerCase();

          return /\b(hostel|boys'? hostel|girls'? hostel|sweet shop|sweets|scheme no\.?\s*\d*)\b/i.test(text);
        };

        const normalizeHotelName = (value) =>
          String(value || "")
            .normalize("NFKD")
            .replace(/[\u0300-\u036f]/g, "")
            .toLowerCase()
            .replace(/\b(indore|india|hotel|hotels|the|residency|residence|resort|inn|lodge|suites|suite|guest|house|rooms|room)\b/g, " ")
            .replace(/[^a-z0-9]+/g, " ")
            .trim()
            .replace(/\s+/g, " ");

        const resultPriority = (hotel) => {
          if (hotel.source === "stayingapi" && Number(hotel.price) > 0) return 100;
          if (hotel.priceSource === "live" && Number(hotel.price) > 0) return 90;
          if (hotel.source === "osm") return 10;
          return 50;
        };

        const uniqueHotels = new Map();

        for (const hotel of data) {
          if (
            !hotel ||
            !hotel.name ||
            /\btest hotel\b/i.test(String(hotel.name)) ||
            isIrrelevantOsmListing(hotel)
          ) {
            continue;
          }

          const key = normalizeHotelName(hotel.name);

          // Keep unrecognisable names separate instead of merging them together.
          const uniqueKey = key || `id:${hotel.id || uniqueHotels.size}`;
          const existing = uniqueHotels.get(uniqueKey);

          if (
            !existing ||
            resultPriority(hotel) > resultPriority(existing)
          ) {
            uniqueHotels.set(uniqueKey, hotel);
          }
        }

        data = Array.from(uniqueHotels.values());

        const pricesInINR = await convertHotelPricesToINR(data);

        if (active) {
          setHotels(pricesInINR);
        }
      } catch (error) {
        if (active) {
          setApiError(error.message || "Unable to load hotels.");
          setHotels([]);
        }
      } finally {
        if (active) {
          setLoading(false);
        }
      }
    }

    loadHotels();

    return () => {
      active = false;
    };
  }, [searchKey]);

  const locations = [...new Set(hotels.map((hotel) => hotel.location))];

  const filteredHotels = useMemo(() => {
    const wantedCity = normalizeCity(search);

    const filtered = hotels.filter((hotel) => {
      const matchesCity =
        !wantedCity ||
        normalizeCity(getCity(hotel.location)) === wantedCity;

      const matchesLocation =
        location === "All" || hotel.location === location;

      const matchesCategory =
        category === "All" || hotel.category === category;

      const hasComparablePrice =
        !hotel.priceConversionUnavailable &&
        Number.isFinite(Number(hotel.price)) &&
        Number(hotel.price) > 0;

      const matchesPrice =
        priceRange === "All" ||
        (hasComparablePrice &&
          ((priceRange === "Under ₹3000" && Number(hotel.price) < 3000) ||
          (priceRange === "₹3000 - ₹6000" &&
            Number(hotel.price) >= 3000 &&
            Number(hotel.price) <= 6000) ||
          (priceRange === "₹6000 - ₹10000" &&
            Number(hotel.price) > 6000 &&
            Number(hotel.price) <= 10000) ||
          (priceRange === "Above ₹10000" && Number(hotel.price) > 10000)));

      const matchesRating =
        rating === "All" || hotel.rating >= Number(rating);

      return (
        matchesCity &&
        matchesLocation &&
        matchesCategory &&
        matchesPrice &&
        matchesRating
      );
    });

    return [...filtered].sort((a, b) => {
      const aHasLiveRate =
        a.priceSource === "live" && Number(a.price) > 0;
      const bHasLiveRate =
        b.priceSource === "live" && Number(b.price) > 0;

      // Price sorting: confirmed live rates first; catalogue estimates after.
      if (sort === "Price Low" || sort === "Price High") {
        if (aHasLiveRate !== bHasLiveRate) {
          return Number(bHasLiveRate) - Number(aHasLiveRate);
        }
        const priceDifference = Number(a.price || 0) - Number(b.price || 0);
        return sort === "Price Low" ? priceDifference : -priceDifference;
      }

      if (sort === "Rating") {
        return Number(b.rating || 0) - Number(a.rating || 0);
      }

      // Recommended: hotels with positive live rates appear first.
      if (aHasLiveRate !== bHasLiveRate) {
        return Number(bHasLiveRate) - Number(aHasLiveRate);
      }

      return String(a.name || "").localeCompare(String(b.name || ""));
    });
  }, [
    hotels,
    search,
    location,
    category,
    priceRange,
    rating,
    sort
  ]);

  const clearFilters = () => {
    setSearch("");
    setLocation("All");
    setCategory("All");
    setPriceRange("All");
    setRating("All");
    setSort("Recommended");
  };

  const changeWishlist = async (hotelId) => {
    if (!currentUser) {
      navigate("/login");
      return;
    }

    try {
      const email = String(currentUser.email || "").trim().toLowerCase();

      if (!email) {
        alert("Please login again.");
        navigate("/login");
        return;
      }

      const currentWishlist = await apiRequest(
        `/wishlist?email=${encodeURIComponent(email)}`
      );

      const savedHotels = currentWishlist.data || [];

      const alreadySaved = savedHotels.some(
        (hotel) => Number(hotel.id) === Number(hotelId)
      );

      if (alreadySaved) {
        await apiRequest(
          `/wishlist/${hotelId}?email=${encodeURIComponent(email)}`,
          {
            method: "DELETE"
          }
        );
      } else {
        await apiRequest("/wishlist", {
          method: "POST",
          body: JSON.stringify({
            email,
            name: currentUser.name || "Guest",
            phone: currentUser.phone || "",
            hotelId: Number(hotelId)
          })
        });
      }

      const updatedWishlist = await apiRequest(
        `/wishlist?email=${encodeURIComponent(email)}`
      );

      const updatedIds = (updatedWishlist.data || []).map(
        (hotel) => Number(hotel.id)
      );

      setWishlist(updatedIds);

      window.dispatchEvent(new Event("stayhub-wishlist-change"));
    } catch (error) {
      console.error("WISHLIST ERROR:", error);
      alert(error.message || "Unable to update wishlist.");
    }
  };

  const keepSearchParams = (hotel) => {
    const next = new URLSearchParams();

    [
      "checkIn",
      "checkOut",
      "rooms",
      "adults",
      "children",
      "childAges"
    ].forEach((key) => {
      const value = params.get(key);
      if (value) next.set(key, value);
    });

    if (hotel?.rateKey) {
      next.set("rateKey", String(hotel.rateKey));
    }

    return next.toString()
      ? `/hotels/${hotel.id}?${next.toString()}`
      : `/hotels/${hotel.id}`;
  };

  return (
    <div
      style={{
        minHeight: "100vh",
        background: "#f8fafc",
        color: "#0f172a"
      }}
    >
      <Navbar />

      <header
        style={{
          background:
            "linear-gradient(135deg, #312e81 0%, #4f46e5 55%, #6366f1 100%)",
          color: "white",
          padding: "28px 20px 42px"
        }}
      >
        <div style={{ maxWidth: 1200, margin: "0 auto" }}>
          <Link
            to="/"
            style={{
              color: "white",
              textDecoration: "none",
              fontSize: 14,
              opacity: 0.9
            }}
          >
            ← Back to Home
          </Link>

          <h1
            style={{
              margin: "25px 0 8px",
              fontSize: 38,
              fontWeight: 800
            }}
          >
            Find Your Perfect Stay
          </h1>

          <p
            style={{
              margin: 0,
              fontSize: 16,
              opacity: 0.9
            }}
          >
            Search hotels, resorts and comfortable stays with STAYHUB.
          </p>
        </div>
      </header>

      <section
        style={{
          maxWidth: 1200,
          margin: "-22px auto 0",
          padding: "0 20px",
          position: "relative",
          zIndex: 2
        }}
      >
        <div
          style={{
            background: "white",
            borderRadius: 18,
            padding: 20,
            boxShadow: "0 12px 35px rgba(15,23,42,.12)",
            border: "1px solid #e2e8f0"
          }}
        >
          <div
            style={{
              display: "flex",
              gap: 12,
              alignItems: "end",
              flexWrap: "wrap"
            }}
          >
            <div style={{ flex: "1 1 420px" }}>
              <label
                style={{
                  display: "block",
                  fontWeight: 700,
                  marginBottom: 7,
                  fontSize: 14
                }}
              >
                Search City
              </label>

              <input
                type="text"
                placeholder="Search city"
                value={search}
                onChange={(e) => setSearch(e.target.value)}
                style={{
                  width: "100%",
                  boxSizing: "border-box",
                  padding: "13px 15px",
                  border: "1px solid #cbd5e1",
                  borderRadius: 10,
                  outline: "none",
                  fontSize: 15
                }}
              />

              <div
                style={{
                  color: "#64748b",
                  fontSize: 12,
                  marginTop: 6
                }}
              >
                Only hotels in the selected city will be shown.
              </div>
            </div>

            <button
              type="button"
              onClick={() => setFiltersOpen((v) => !v)}
              style={{
                ...buttonStyle,
                minWidth: 105,
                height: 45,
                background: filtersOpen ? "#eef2ff" : "#fff",
                color: "#3730a3",
                borderColor: filtersOpen ? "#818cf8" : "#cbd5e1"
              }}
            >
              {filtersOpen ? "Hide Filters" : "Filters"} ▾
            </button>
          </div>

          {filtersOpen && (
            <div
              style={{
                marginTop: 14,
                paddingTop: 16,
                borderTop: "1px solid #eef2f7"
              }}
            >
              <div
                style={{
                  display: "grid",
                  gridTemplateColumns:
                    "repeat(auto-fit,minmax(170px,1fr))",
                  gap: 14
                }}
              >
                <label
                  style={{
                    display: "grid",
                    gap: 7,
                    fontSize: 14,
                    fontWeight: 700
                  }}
                >
                  Location
                  <select
                    value={location}
                    onChange={(e) => setLocation(e.target.value)}
                    style={selectStyle}
                  >
                    <option value="All">All Locations</option>
                    {locations.map((item) => (
                      <option key={item} value={item}>
                        {item}
                      </option>
                    ))}
                  </select>
                </label>

                <label
                  style={{
                    display: "grid",
                    gap: 7,
                    fontSize: 14,
                    fontWeight: 700
                  }}
                >
                  Category
                  <select
                    value={category}
                    onChange={(e) => setCategory(e.target.value)}
                    style={selectStyle}
                  >
                    <option value="All">All Categories</option>
                    <option value="Luxury">Luxury</option>
                    <option value="Premium">Premium</option>
                    <option value="Budget">Budget</option>
                    <option value="Resort">Resort</option>
                  </select>
                </label>

                <label
                  style={{
                    display: "grid",
                    gap: 7,
                    fontSize: 14,
                    fontWeight: 700
                  }}
                >
                  Price
                  <select
                    value={priceRange}
                    onChange={(e) => setPriceRange(e.target.value)}
                    style={selectStyle}
                  >
                    <option value="All">All Prices</option>
                    <option value="Under ₹3000">Under ₹3,000</option>
                    <option value="₹3000 - ₹6000">
                      ₹3,000 - ₹6,000
                    </option>
                    <option value="₹6000 - ₹10000">
                      ₹6,000 - ₹10,000
                    </option>
                    <option value="Above ₹10000">
                      Above ₹10,000
                    </option>
                  </select>
                </label>

                <label
                  style={{
                    display: "grid",
                    gap: 7,
                    fontSize: 14,
                    fontWeight: 700
                  }}
                >
                  Rating
                  <select
                    value={rating}
                    onChange={(e) => setRating(e.target.value)}
                    style={selectStyle}
                  >
                    <option value="All">All Ratings</option>
                    <option value="4.5">4.5+ Rating</option>
                    <option value="4.0">4.0+ Rating</option>
                    <option value="3.5">3.5+ Rating</option>
                  </select>
                </label>

                <label
                  style={{
                    display: "grid",
                    gap: 7,
                    fontSize: 14,
                    fontWeight: 700
                  }}
                >
                  Sort By
                  <select
                    value={sort}
                    onChange={(e) => setSort(e.target.value)}
                    style={selectStyle}
                  >
                    <option value="Recommended">Recommended</option>
                    <option value="Price Low">
                      Price: Low to High
                    </option>
                    <option value="Price High">
                      Price: High to Low
                    </option>
                    <option value="Rating">
                      Highest Rating
                    </option>
                  </select>
                </label>
              </div>

              <div
                style={{
                  display: "flex",
                  justifyContent: "space-between",
                  alignItems: "center",
                  gap: 12,
                  flexWrap: "wrap",
                  marginTop: 15
                }}
              >
                <span
                  style={{
                    color: "#64748b",
                    fontSize: 14,
                    fontWeight: 600
                  }}
                >
                  {filteredHotels.length} stays found
                </span>

                <button
                  type="button"
                  onClick={clearFilters}
                  style={buttonStyle}
                >
                  Clear Filters
                </button>
              </div>
            </div>
          )}
        </div>
      </section>

      <main
        style={{
          maxWidth: 1200,
          margin: "0 auto",
          padding: "35px 20px 60px"
        }}
      >
        {liveSearchWarning && (
          <div role="status" style={{ marginBottom: 18, padding: "14px 16px", borderRadius: 12, background: "#fff7ed", border: "1px solid #fed7aa", color: "#9a3412" }}>
            {liveSearchWarning}
          </div>
        )}
        {loading ? (
          <div
            style={{
              background: "white",
              borderRadius: 18,
              padding: "60px 20px",
              textAlign: "center",
              border: "1px solid #e2e8f0"
            }}
          >
            <div style={{ fontSize: 42, marginBottom: 12 }}>🏨</div>
            <h2 style={{ margin: 0 }}>Loading stays...</h2>
          </div>
        ) : apiError ? (
          <div
            style={{
              background: "white",
              borderRadius: 18,
              padding: "60px 20px",
              textAlign: "center",
              border: "1px solid #e2e8f0"
            }}
          >
            <div style={{ fontSize: 42, marginBottom: 12 }}>⚠️</div>
            <h2 style={{ margin: "0 0 8px" }}>
              Unable to load stays
            </h2>
            <p style={{ color: "#64748b", margin: 0 }}>
              {apiError}
            </p>
          </div>
        ) : !filteredHotels.length ? (
          <div
            style={{
              background: "white",
              borderRadius: 18,
              padding: "60px 20px",
              textAlign: "center",
              border: "1px solid #e2e8f0"
            }}
          >
            <div style={{ fontSize: 50, marginBottom: 15 }}>🔍</div>

            <h2 style={{ margin: "0 0 8px" }}>
              No stays found
            </h2>

            <p
              style={{
                color: "#64748b",
                marginBottom: 20
              }}
            >
              Try another city or change your filters.
            </p>

            <button
              onClick={clearFilters}
              style={{
                background: "#4f46e5",
                color: "white",
                border: 0,
                padding: "12px 20px",
                borderRadius: 10,
                cursor: "pointer",
                fontWeight: 700
              }}
            >
              Reset Filters
            </button>
          </div>
        ) : (
          <div
            style={{
              display: "grid",
              gridTemplateColumns:
                "repeat(auto-fill,minmax(280px,1fr))",
              gap: 24
            }}
          >
            {filteredHotels.map((hotel) => {
              const saved = wishlist.includes(Number(hotel.id));

              return (
                <div
                  key={hotel.id}
                  style={{
                    background: "white",
                    borderRadius: 18,
                    overflow: "hidden",
                    border: "1px solid #e2e8f0",
                    boxShadow:
                      "0 8px 25px rgba(15,23,42,.07)"
                  }}
                >
                  <div
                    style={{
                      position: "relative",
                      height: 210,
                      overflow: "hidden"
                    }}
                  >
                    <img
                      src={safeHotelImage(hotel.image)} onError={handleHotelImageError}
                      alt={hotel.name}
                      style={{
                        width: "100%",
                        height: "100%",
                        objectFit: "cover",
                        display: "block"
                      }}
                    />

                    <span
                      style={{
                        position: "absolute",
                        top: 12,
                        left: 12,
                        background: "rgba(15,23,42,.82)",
                        color: "white",
                        padding: "6px 10px",
                        borderRadius: 20,
                        fontSize: 12,
                        fontWeight: 700
                      }}
                    >
                      {hotel.category}
                    </span>

                    <span
                      style={{
                        position: "absolute",
                        top: 12,
                        right: 60,
                        background: "white",
                        color: "#0f172a",
                        padding: "6px 9px",
                        borderRadius: 20,
                        fontSize: 13,
                        fontWeight: 800
                      }}
                    >
                      {Number(hotel.rating) > 0
                        ? `⭐ ${Number(hotel.rating).toFixed(1)}`
                        : "Not rated"}
                    </span>

                    {!hotel.externalOnly && (
                    <button
                      type="button"
                      onClick={() => changeWishlist(hotel.id)}
                      style={{
                        position: "absolute",
                        top: 10,
                        right: 10,
                        width: 40,
                        height: 40,
                        borderRadius: "50%",
                        border: 0,
                        background: "rgba(255,255,255,.96)",
                        cursor: "pointer",
                        fontSize: 21
                      }}
                      aria-label={
                        saved
                          ? "Remove from wishlist"
                          : "Add to wishlist"
                      }
                    >
                      {saved ? "♥" : "♡"}
                    </button>
                  )}
                  </div>

                  <div style={{ padding: 18 }}>
                    <h2
                      style={{
                        margin: "0 0 7px",
                        fontSize: 20,
                        lineHeight: 1.25
                      }}
                    >
                      {hotel.name}
                    </h2>

                    <div
                      style={{
                        color: "#64748b",
                        fontSize: 14,
                        marginBottom: 12
                      }}
                    >
                      📍 {hotel.location}
                    </div>

                    <p
                      style={{
                        color: "#64748b",
                        fontSize: 14,
                        lineHeight: 1.55,
                        margin: "0 0 17px"
                      }}
                    >
                      {hotel.description}
                    </p>

                    <div
                      style={{
                        display: "flex",
                        justifyContent: "space-between",
                        alignItems: "end",
                        gap: 10
                      }}
                    >
                      <div>
                        <div
                          style={{
                            color: "#64748b",
                            fontSize: 12
                          }}
                        >
                          {hotel.priceSource === "live" && Number(hotel.price) > 0
                            ? "Live price for selected dates"
                            : hotel.priceSource === "demo-estimate"
                              ? "Demo estimate (not verified)"
                              : hotel.priceSource === "estimate"
                                ? "Estimated starting price · not live-confirmed"
                                : params.get("checkIn") && params.get("checkOut")
                                  ? "Catalogue estimate (not live-confirmed)"
                                  : "Starting from"}
                        </div>

                        <div
                          style={{
                            fontSize: 21,
                            fontWeight: 800
                          }}
                        >
                          {Number(hotel.price) > 0 ? (
                            (() => {
                              const amount = Number(hotel.price);
                              const currency = String(hotel.currency || "INR").toUpperCase();

                              try {
                                return new Intl.NumberFormat("en-IN", {
                                  style: "currency",
                                  currency,
                                  maximumFractionDigits: 0,
                                }).format(amount);
                              } catch {
                                return `${amount.toLocaleString("en-IN")} ${currency}`;
                              }
                            })()
                          ) : (
                            hotel.priceConversionUnavailable
                              ? "INR conversion unavailable"
                              : params.get("checkIn") && params.get("checkOut")
                                ? "Price unavailable for selected dates"
                                : "Select dates to see price"
                          )}
                        </div>

                        <div
                          style={{
                            color: "#64748b",
                            fontSize: 12
                          }}
                        >
                          per night
                        </div>
                      </div>

                      {hotel.externalOnly ? (
                        hotel.externalUrl ? (
                          <a
                            href={hotel.externalUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                            style={{
                              background: "#4f46e5",
                              color: "white",
                              textDecoration: "none",
                              padding: "11px 16px",
                              borderRadius: 10,
                              fontWeight: 700,
                              fontSize: 14,
                              whiteSpace: "nowrap"
                            }}
                          >
                            View Offer ↗
                          </a>
                        ) : (
                          <span style={{ color: "#64748b", fontSize: 13 }}>
                            Offer link unavailable
                          </span>
                        )
                      ) : (
                        <Link
                          to={keepSearchParams(hotel)}
                          style={{
                            background: "#4f46e5",
                            color: "white",
                            textDecoration: "none",
                            padding: "11px 16px",
                            borderRadius: 10,
                            fontWeight: 700,
                            fontSize: 14,
                            whiteSpace: "nowrap"
                          }}
                        >
                          View Details
                        </Link>
                      )}
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        )}
      </main>

      <footer
        style={{
          background: "#0f172a",
          color: "white",
          textAlign: "center",
          padding: "25px 20px"
        }}
      >
        <div style={{ fontWeight: 800, fontSize: 20 }}>
          STAYHUB
        </div>

        <p
          style={{
            margin: "7px 0 0",
            color: "#94a3b8",
            fontSize: 14
          }}
        >
          Find. Book. Stay.
        </p>
      </footer>
    </div>
  );
}

export default Hotels;
