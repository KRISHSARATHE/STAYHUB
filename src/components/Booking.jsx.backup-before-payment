import { apiRequest } from "../utils/api";
import { Link, useNavigate, useSearchParams } from "react-router-dom";
import { useEffect, useState } from "react";

import stayhubLogo from "../assets/logo.svg";
import GuestSelector from "./GuestSelector";
import { getMinDate, tomorrowInput, calculateNights as getNights, validateGuestSelection, openInvoice } from "../utils/stayhub";

// ======================================================
// HOTEL DATA
// ======================================================

;

// ======================================================
// BOOKING COMPONENT
// ======================================================

function Booking() {
  const [searchParams] = useSearchParams();
  const navigate = useNavigate();

  const hotelId = Number(searchParams.get("hotel"));

  const selectedCheckIn = searchParams.get("checkIn") || "";
  const selectedCheckOut = searchParams.get("checkOut") || "";
  const selectedRooms = Number(searchParams.get("rooms") || 1);
  const selectedAdults = Number(searchParams.get("adults") || searchParams.get("guests") || 2);
  const selectedChildren = Number(searchParams.get("children") || 0);
  const selectedAges = (searchParams.get("childAges") || "").split(",").filter(Boolean).map(Number);

  const [hotels, setHotels] = useState([]);
  const [hotelLoading, setHotelLoading] = useState(true);

  const [currentUser, setCurrentUser] = useState(null);

  // ====================================================
  // LOAD HOTEL FROM POSTGRESQL API
  // ====================================================

  useEffect(() => {
    let active = true;

    async function loadHotel() {
      try {
        const result = await apiRequest("/hotels");
        const data = result.data || [];

        if (active) {
          setHotels(data);
        }
      } catch (error) {
        console.error("Failed to load hotel:", error);

        if (active) {
          setHotels([]);
        }
      } finally {
        if (active) {
          setHotelLoading(false);
        }
      }
    }

    loadHotel();

    return () => {
      active = false;
    };
  }, []);

  const hotel = hotels.find((item) => item.id === hotelId);

  const [formData, setFormData] = useState({
    name: "",
    email: "",
    phone: "",
    checkIn: selectedCheckIn,
    checkOut: selectedCheckOut,
    rooms: selectedRooms,
    adults: selectedAdults,
    children: selectedChildren,
    childAges: Array.from({ length: selectedChildren }, (_, index) => selectedAges[index] ?? 8),
  });
  const [verified, setVerified] = useState(false);

  const [confirmedBooking, setConfirmedBooking] = useState(null);

  // ====================================================
  // LOAD CURRENT USER
  // ====================================================

  useEffect(() => {
    const savedUser = localStorage.getItem(
      "stayhubCurrentUser"
    );

    if (!savedUser) {
      alert("Please login before booking.");
      navigate("/login");
      return;
    }

    try {
      const user = JSON.parse(savedUser);

      setCurrentUser(user);

      setFormData((prev) => ({
        ...prev,
        name: user.name || "",
        email: user.email || "",
        phone: user.mobile || "",
      }));
    } catch (error) {
      console.error("User data error:", error);

      localStorage.removeItem(
        "stayhubCurrentUser"
      );

      navigate("/login");
    }
  }, [navigate]);

  // ====================================================
  // HOTEL LOADING
  // ====================================================

  if (hotelLoading) {
    return (
      <div
        style={{
          minHeight: "100vh",
          display: "flex",
          justifyContent: "center",
          alignItems: "center",
          textAlign: "center",
          padding: "30px",
          background: "#f8fafc",
        }}
      >
        <div>
          <h2>Loading hotel...</h2>
          <p style={{ color: "#64748b" }}>
            Please wait while we load the hotel details.
          </p>
        </div>
      </div>
    );
  }

  // ====================================================
  // HOTEL NOT FOUND
  // ====================================================

  if (!hotel) {
    return (
      <div
        style={{
          minHeight: "100vh",
          display: "flex",
          justifyContent: "center",
          alignItems: "center",
          textAlign: "center",
          padding: "30px",
          background: "#f8fafc",
        }}
      >
        <div>
          <div style={{ fontSize: "70px" }}>
            
          </div>

          <h1>Hotel Not Found</h1>

          <p
            style={{
              color: "#64748b",
              marginBottom: "20px",
            }}
          >
            Please select a valid hotel.
          </p>

          <Link
            to="/hotels"
            style={{
              display: "inline-block",
              padding: "12px 22px",
              background: "#4f46e5",
              color: "#fff",
              borderRadius: "10px",
              textDecoration: "none",
              fontWeight: "600",
            }}
          >
            ← Browse Hotels
          </Link>
        </div>
      </div>
    );
  }

  // ====================================================
  // INPUT HANDLER
  // ====================================================

  const handleChange = (e) => {
    const { name, value } = e.target;

    setFormData((prev) => ({
      ...prev,
      [name]: value,
    }));
  };

  // ====================================================
  // CALCULATE NIGHTS
  // ====================================================

  const calculateNights = () => getNights(formData.checkIn, formData.checkOut);

  const nights = calculateNights();

  const roomSubtotal = nights > 0 ? nights * hotel.price * Number(formData.rooms || 1) : 0;
  const totalAmount = roomSubtotal;

  // ====================================================
  // SUBMIT BOOKING
  // ====================================================

  const handleSubmit = async (e) => {
    e.preventDefault();

    const savedUser = localStorage.getItem(
      "stayhubCurrentUser"
    );

    if (!savedUser) {
      alert("Please login before booking.");
      navigate("/login");
      return;
    }

    let user;

    try {
      user = JSON.parse(savedUser);
    } catch {
      alert("Please login again.");
      navigate("/login");
      return;
    }

    // ----------------------------------------------
    // NAME
    // ----------------------------------------------

    if (!formData.name.trim()) {
      alert("Please enter your name.");
      return;
    }

    // ----------------------------------------------
    // EMAIL
    // ----------------------------------------------

    if (!formData.email.trim()) {
      alert("Please enter your email.");
      return;
    }

    // ----------------------------------------------
    // PHONE
    // ----------------------------------------------

    const phone = formData.phone.trim();

    if (!/^[6-9]\d{9}$/.test(phone)) {
      alert(
        "Please enter a valid 10-digit Indian mobile number."
      );
      return;
    }

    // ----------------------------------------------
    // DATES
    // ----------------------------------------------

    if (!formData.checkIn) {
      alert("Please select check-in date.");
      return;
    }

    if (!formData.checkOut) {
      alert("Please select check-out date.");
      return;
    }

    const startDate = new Date(
      formData.checkIn
    );

    const endDate = new Date(
      formData.checkOut
    );

    if (endDate <= startDate) {
      alert(
        "Check-out date must be after check-in date."
      );
      return;
    }

    if (nights <= 0) {
      alert("Please select valid booking dates.");
      return;
    }

    const guestError = validateGuestSelection(formData);
    if (guestError) {
      alert(guestError);
      return;
    }

    if (!verified) {
      alert("Please confirm that your booking details are correct.");
      return;
    }

    // ----------------------------------------------
    // BOOKING ID
    // ----------------------------------------------

    const bookingId =
      "STH-" +
      new Date().getFullYear() +
      "-" +
      Math.floor(
        100000 +
          Math.random() * 900000
      );

    // ----------------------------------------------
    // BOOKING OBJECT
    // ----------------------------------------------

    const booking = {
      id: bookingId,

      userId:
        user.id ||
        user.loginId ||
        user.email,

      userEmail:
        user.email ||
        formData.email,

      hotelId: hotel.id,

      hotelName: hotel.name,

      location: hotel.location,

      image: hotel.image,

      name: formData.name.trim(),

      email: formData.email.trim(),

      phone: phone,

      checkIn: formData.checkIn,

      checkOut: formData.checkOut,

      rooms: Number(formData.rooms),
      adults: Number(formData.adults),
      children: Number(formData.children),
      childAges: formData.childAges,
      guests: Number(formData.adults) + Number(formData.children),
      nights,
      roomAmount: roomSubtotal,
      serviceFee: 0,
      tax: 0,
      total: totalAmount,
      price: totalAmount,
      room: "Deluxe Room",
      status: "Confirmed",

      bookedAt:
        new Date().toISOString(),
    };
    // ----------------------------------------------
    // SAVE BOOKING TO POSTGRESQL API
    // ----------------------------------------------

    try {
      const result = await apiRequest("/bookings", {
        method: "POST",
        body: JSON.stringify({
          ...booking,
          userEmail: user.email || formData.email,
          provider: user.provider || "email",
          verified: true,
        }),
      });

      const savedBooking = result.data || booking;

      // Keep local copy for backward compatibility
      const existingBookings =
        JSON.parse(localStorage.getItem("stayhubBookings") || "[]");

      const mergedBookings = [
        ...existingBookings.filter((item) => item.id !== savedBooking.id),
        savedBooking,
      ];

      localStorage.setItem(
        "stayhubBookings",
        JSON.stringify(mergedBookings)
      );

      setConfirmedBooking(savedBooking);
    } catch (error) {
      console.error("Booking API error:", error);
      alert(error.message || "Booking could not be saved.");
      return;
    }

  };

  // ====================================================
  // CONFIRMATION PAGE
  // ====================================================

  if (confirmedBooking) {
    return (
      <div
        style={{
          minHeight: "100vh",
          background:
            "linear-gradient(135deg, #eef2ff, #f8fafc)",
          padding: "40px 20px",
        }}
      >
        <div
          style={{
            maxWidth: "800px",
            margin: "0 auto",
            background: "#fff",
            borderRadius: "20px",
            padding: "40px",
            boxShadow:
              "0 20px 50px rgba(0,0,0,0.08)",
          }}
        >
          {/* SUCCESS */}

          <div
            style={{
              textAlign: "center",
              marginBottom: "30px",
            }}
          >
            <div
              style={{
                width: "75px",
                height: "75px",
                borderRadius: "50%",
                background: "#dcfce7",
                color: "#16a34a",
                display: "flex",
                alignItems: "center",
                justifyContent: "center",
                fontSize: "38px",
                margin: "0 auto 20px",
              }}
            >
              ✓
            </div>

            <h1
              style={{
                marginBottom: "8px",
              }}
            >
              Booking Confirmed!
            </h1>

            <p
              style={{
                color: "#64748b",
              }}
            >
              Your hotel reservation has been
              successfully created.
            </p>
          </div>

          {/* HOTEL */}

          <div
            style={{
              display: "flex",
              gap: "20px",
              padding: "20px",
              background: "#f8fafc",
              borderRadius: "15px",
              marginBottom: "25px",
            }}
          >
            <img
              src={confirmedBooking.image}
              alt={confirmedBooking.hotelName}
              style={{
                width: "150px",
                height: "110px",
                objectFit: "cover",
                borderRadius: "12px",
              }}
            />

            <div>
              <h2
                style={{
                  marginBottom: "8px",
                }}
              >
                {confirmedBooking.hotelName}
              </h2>

              <p
                style={{
                  color: "#64748b",
                }}
              >
                📍 {confirmedBooking.location}
              </p>

              <p>
                ⭐ Hotel Booking
              </p>
            </div>
          </div>

          {/* BOOKING DETAILS */}

          <div
            style={{
              display: "grid",
              gridTemplateColumns:
                "repeat(auto-fit, minmax(180px, 1fr))",
              gap: "15px",
              marginBottom: "25px",
            }}
          >
            <div>
              <small>BOOKING ID</small>
              <strong
                style={{
                  display: "block",
                  marginTop: "5px",
                }}
              >
                {confirmedBooking.id}
              </strong>
            </div>

            <div>
              <small>CHECK-IN</small>
              <strong
                style={{
                  display: "block",
                  marginTop: "5px",
                }}
              >
                {confirmedBooking.checkIn}
              </strong>
            </div>

            <div>
              <small>CHECK-OUT</small>
              <strong
                style={{
                  display: "block",
                  marginTop: "5px",
                }}
              >
                {confirmedBooking.checkOut}
              </strong>
            </div>

            <div>
              <small>GUESTS</small>
              <strong
                style={{
                  display: "block",
                  marginTop: "5px",
                }}
              >
                {confirmedBooking.guests}
              </strong>
            </div>

            <div>
              <small>ROOMS</small>
              <strong style={{ display: "block", marginTop: "5px" }}>
                {confirmedBooking.rooms}
              </strong>
            </div>

            <div>
              <small>ADULTS / CHILDREN</small>
              <strong style={{ display: "block", marginTop: "5px" }}>
                {confirmedBooking.adults} / {confirmedBooking.children}
              </strong>
            </div>

            <div>
              <small>ROOM</small>
              <strong
                style={{
                  display: "block",
                  marginTop: "5px",
                }}
              >
                {confirmedBooking.room}
              </strong>
            </div>

            <div>
              <small>NIGHTS</small>
              <strong
                style={{
                  display: "block",
                  marginTop: "5px",
                }}
              >
                {confirmedBooking.nights}
              </strong>
            </div>
          </div>

          {/* TOTAL */}

          <div
            style={{
              padding: "20px",
              background: "#eef2ff",
              borderRadius: "12px",
              display: "flex",
              justifyContent: "space-between",
              alignItems: "center",
              marginBottom: "25px",
            }}
          >
            <strong>
              Total Amount
            </strong>

            <strong
              style={{
                fontSize: "24px",
                color: "#4f46e5",
              }}
            >
              ₹
              {confirmedBooking.price.toLocaleString(
                "en-IN"
              )}
            </strong>
          </div>

          {/* ACTIONS */}

          <div
            style={{
              display: "flex",
              gap: "12px",
              flexWrap: "wrap",
            }}
          >
            <button
              type="button"
              onClick={() => openInvoice(confirmedBooking)}
              style={{
                flex: "1",
                minWidth: "180px",
                textAlign: "center",
                padding: "14px",
                background: "#0f172a",
                color: "#fff",
                border: "none",
                borderRadius: "10px",
                fontWeight: "600",
                cursor: "pointer",
              }}
            >
              Download Bill (PDF)
            </button>

            <Link
              to="/my-bookings"
              style={{
                flex: "1",
                minWidth: "180px",
                textAlign: "center",
                padding: "14px",
                background: "#4f46e5",
                color: "#fff",
                textDecoration: "none",
                borderRadius: "10px",
                fontWeight: "600",
              }}
            >
              View My Bookings
            </Link>

            <Link
              to="/hotels"
              style={{
                flex: "1",
                minWidth: "180px",
                textAlign: "center",
                padding: "14px",
                background: "#f1f5f9",
                color: "#334155",
                textDecoration: "none",
                borderRadius: "10px",
                fontWeight: "600",
              }}
            >
              Book Another Hotel
            </Link>
          </div>
        </div>
      </div>
    );
  }

  // ====================================================
  // MAIN BOOKING PAGE
  // ====================================================

  return (
    <div
      style={{
        minHeight: "100vh",
        background: "#f8fafc",
      }}
    >
      {/* ==================================================
          HEADER
      ================================================== */}

      <header
        style={{
          background: "#fff",
          borderBottom:
            "1px solid #e5e7eb",
          padding: "16px 5%",
          display: "flex",
          justifyContent: "space-between",
          alignItems: "center",
          gap: "15px",
          flexWrap: "wrap",
        }}
      >
        <Link
          to="/"
          style={{
            textDecoration: "none",
            fontWeight: "800",
            fontSize: "22px",
            color: "#4f46e5",
          }}
        >
          STAYHUB
        </Link>

        <button
          onClick={() => navigate(-1)}
          style={{
            border: "none",
            background: "#f1f5f9",
            padding: "10px 16px",
            borderRadius: "8px",
            cursor: "pointer",
            fontWeight: "600",
          }}
        >
          ← Back
        </button>
      </header>

      {/* ==================================================
          MAIN
      ================================================== */}

      <main
        style={{
          maxWidth: "1100px",
          margin: "0 auto",
          padding: "40px 20px",
        }}
      >
        <div
          style={{
            marginBottom: "30px",
          }}
        >
          <p
            style={{
              color: "#4f46e5",
              fontWeight: "700",
              marginBottom: "5px",
            }}
          >
            STAYHUB RESERVATION
          </p>

          <h1>
            Complete Your Booking
          </h1>

          <p
            style={{
              color: "#64748b",
            }}
          >
            Enter your details to confirm your
            hotel reservation.
          </p>
        </div>

        <div
          style={{
            display: "grid",
            gridTemplateColumns:
              "minmax(0, 1.4fr) minmax(300px, 0.8fr)",
            gap: "25px",
          }}
        >
          {/* =================================================
              FORM
          ================================================= */}

          <form
            onSubmit={handleSubmit}
            style={{
              background: "#fff",
              padding: "30px",
              borderRadius: "18px",
              boxShadow:
                "0 10px 30px rgba(0,0,0,0.05)",
            }}
          >
            <h2>
              Guest Details
            </h2>

            {/* NAME */}

            <div
              style={{
                marginTop: "20px",
              }}
            >
              <label
                style={{
                  display: "block",
                  marginBottom: "7px",
                  fontWeight: "600",
                }}
              >
                Full Name
              </label>

              <input
                type="text"
                name="name"
                value={formData.name}
                onChange={handleChange}
                placeholder="Enter your full name"
                required
                style={{
                  width: "100%",
                  padding: "13px",
                  border:
                    "1px solid #d1d5db",
                  borderRadius: "9px",
                  boxSizing: "border-box",
                }}
              />
            </div>

            {/* EMAIL */}

            <div
              style={{
                marginTop: "18px",
              }}
            >
              <label
                style={{
                  display: "block",
                  marginBottom: "7px",
                  fontWeight: "600",
                }}
              >
                Email Address
              </label>

              <input
                type="email"
                name="email"
                value={formData.email}
                onChange={handleChange}
                placeholder="Enter your email"
                required
                style={{
                  width: "100%",
                  padding: "13px",
                  border:
                    "1px solid #d1d5db",
                  borderRadius: "9px",
                  boxSizing: "border-box",
                }}
              />
            </div>

            {/* PHONE */}

            <div
              style={{
                marginTop: "18px",
              }}
            >
              <label
                style={{
                  display: "block",
                  marginBottom: "7px",
                  fontWeight: "600",
                }}
              >
                Mobile Number
              </label>

              <input
                type="tel"
                name="phone"
                value={formData.phone}
                onChange={handleChange}
                placeholder="10-digit mobile number"
                maxLength="10"
                required
                style={{
                  width: "100%",
                  padding: "13px",
                  border:
                    "1px solid #d1d5db",
                  borderRadius: "9px",
                  boxSizing: "border-box",
                }}
              />
            </div>

            {/* DATES */}

            <div
              style={{
                display: "grid",
                gridTemplateColumns:
                  "1fr 1fr",
                gap: "15px",
                marginTop: "18px",
              }}
            >
              <div>
                <label
                  style={{
                    display: "block",
                    marginBottom: "7px",
                    fontWeight: "600",
                  }}
                >
                  Check-in
                </label>

                <input
                  type="date"
                  name="checkIn"
                  min={getMinDate()}
                  value={formData.checkIn}
                  onChange={(e) => {
                    const value = e.target.value;
                    setFormData((prev) => ({ ...prev, checkIn: value, checkOut: prev.checkOut && prev.checkOut > value ? prev.checkOut : "" }));
                  }}
                  required
                  style={{
                    width: "100%",
                    padding: "13px",
                    border:
                      "1px solid #d1d5db",
                    borderRadius: "9px",
                    boxSizing: "border-box",
                  }}
                />
              </div>

              <div>
                <label
                  style={{
                    display: "block",
                    marginBottom: "7px",
                    fontWeight: "600",
                  }}
                >
                  Check-out
                </label>

                <input
                  type="date"
                  name="checkOut"
                  min={formData.checkIn ? tomorrowInput(formData.checkIn) : tomorrowInput()}
                  disabled={!formData.checkIn}
                  value={formData.checkOut}
                  onChange={handleChange}
                  required
                  style={{
                    width: "100%",
                    padding: "13px",
                    border:
                      "1px solid #d1d5db",
                    borderRadius: "9px",
                    boxSizing: "border-box",
                  }}
                />
              </div>
            </div>

            {/* GUESTS */}

            <div style={{ marginTop: "18px", position: "relative" }}>
              <label style={{ display: "block", marginBottom: "7px", fontWeight: "600" }}>
                Number of Guests
              </label>
              <div style={{ border: "1px solid #d1d5db", borderRadius: "9px", padding: "0 13px" }}>
                <GuestSelector
                  value={{ rooms: formData.rooms, adults: formData.adults, children: formData.children, childAges: formData.childAges }}
                  onChange={(value) => setFormData((prev) => ({ ...prev, ...value }))}
                />
              </div>
            </div>

            <label style={{ display: "flex", gap: "9px", alignItems: "flex-start", marginTop: "18px", color: "#475569", fontSize: "13px", lineHeight: 1.4 }}>
              <input type="checkbox" checked={verified} onChange={(e) => setVerified(e.target.checked)} required style={{ marginTop: "3px" }} />
              <span>I confirm that my guest, contact and stay details are correct.</span>
            </label>

            {/* SUBMIT */}

            <button
              type="submit"
              style={{
                width: "100%",
                marginTop: "25px",
                padding: "15px",
                border: "none",
                borderRadius: "10px",
                background: "#4f46e5",
                color: "#fff",
                fontSize: "16px",
                fontWeight: "700",
                cursor: "pointer",
              }}
            >
              Confirm Booking →
            </button>

            <p
              style={{
                textAlign: "center",
                marginTop: "12px",
                color: "#64748b",
                fontSize: "13px",
              }}
            >
              🔒 No payment required at this stage
            </p>
          </form>

          {/* =================================================
              BOOKING SUMMARY
          ================================================= */}

          <aside
            style={{
              background: "#fff",
              padding: "25px",
              borderRadius: "18px",
              height: "fit-content",
              boxShadow:
                "0 10px 30px rgba(0,0,0,0.05)",
            }}
          >
            <h2>
              Booking Summary
            </h2>

            <img
              src={hotel.image}
              alt={hotel.name}
              style={{
                width: "100%",
                height: "190px",
                objectFit: "cover",
                borderRadius: "12px",
                marginTop: "18px",
              }}
            />

            <h3
              style={{
                marginTop: "18px",
                marginBottom: "6px",
              }}
            >
              {hotel.name}
            </h3>

            <p
              style={{
                color: "#64748b",
                marginBottom: "20px",
              }}
            >
              📍 {hotel.location}
            </p>

            {/* PRICE */}

            <div
              style={{
                borderTop:
                  "1px solid #e5e7eb",
                paddingTop: "18px",
              }}
            >
              <div
                style={{
                  display: "flex",
                  justifyContent:
                    "space-between",
                  marginBottom: "10px",
                }}
              >
                <span>
                  Price / night
                </span>

                <strong>
                  ₹
                  {hotel.price.toLocaleString(
                    "en-IN"
                  )}
                </strong>
              </div>

              <div
                style={{
                  display: "flex",
                  justifyContent:
                    "space-between",
                  marginBottom: "10px",
                }}
              >
                <span>
                  Nights
                </span>

                <strong>
                  {nights || 0}
                </strong>
              </div>

              <div
                style={{
                  display: "flex",
                  justifyContent:
                    "space-between",
                  marginBottom: "10px",
                }}
              >
                <span>
                  Guests
                </span>

                <strong>{formData.adults + formData.children}</strong>
              </div>

              <div style={{ display: "flex", justifyContent: "space-between", marginBottom: "10px" }}><span>Rooms</span><strong>{formData.rooms}</strong></div>
              <div style={{ display: "flex", justifyContent: "space-between", marginBottom: "10px" }}><span>Adults</span><strong>{formData.adults}</strong></div>
              <div style={{ display: "flex", justifyContent: "space-between", marginBottom: "10px" }}><span>Children</span><strong>{formData.children}</strong></div>

              <div
                style={{
                  display: "flex",
                  justifyContent:
                    "space-between",
                  marginTop: "18px",
                  paddingTop: "18px",
                  borderTop:
                    "1px solid #e5e7eb",
                }}
              >
                <strong>
                  Total
                </strong>

                <strong
                  style={{
                    fontSize: "22px",
                    color: "#4f46e5",
                  }}
                >
                  ₹
                  {totalAmount.toLocaleString(
                    "en-IN"
                  )}
                </strong>
              </div>
            </div>
          </aside>
        </div>
      </main>
    </div>
  );
}

export default Booking;